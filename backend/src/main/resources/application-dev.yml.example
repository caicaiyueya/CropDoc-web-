# 本地开发示例：复制为 application-dev.yml 后填写真实值（勿提交密钥）
# 启动：--spring.profiles.active=dev

spring:
  datasource:
    username: root
    password: your_local_password

jwt:
  secret: local_dev_secret_change_me_to_long_random_string_32chars_min

deepseek:
  api-key: sk-your-key-here

app:
  upload:
    base-path: ./uploads
